# setup.sh가 __APP_DIR__, __APP_USER__를 채워 /etc/systemd/system/에 복사한다.
[Unit]
Description=microSNS backend (FastAPI)
After=network.target mysql.service
Requires=mysql.service

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
