# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 git에 올리지 않습니다.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=microsns
# 모든 DB 연결에 적용되는 시간대입니다. 팀 전체가 같은 값을 씁니다.
DB_TIME_ZONE=+09:00

# 32자 이상. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# HTTPS로 배포할 때만 true
COOKIE_SECURE=false
